---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import logoRedondo from '@/assets/logos/logo-redondo.png';
import { sitio } from '@/lib/sitio';

// Favicons generados en el build a partir del logo redondo (cuadrados, sin recortar)
const opcionesIcono = { src: logoRedondo, format: 'png', fit: 'contain', background: 'transparent' } as const;
const favicon = await getImage({ ...opcionesIcono, width: 48, height: 48 });
const appleTouchIcon = await getImage({ ...opcionesIcono, width: 180, height: 180, background: '#ffffff' });

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = `${sitio.nombre} | ${sitio.organizacion}`,
  descripcion = sitio.descripcionMeta,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const imagenOG = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="48x48" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="canonical" href={urlCanonica} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={`${sitio.nombre} | ${sitio.organizacion}`} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
