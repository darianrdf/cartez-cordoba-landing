---
import { instagramUrl, mailtoUrl, sitio, whatsappUrl } from '@/lib/sitio';

const enlaceSecundario =
  'flex min-h-12 items-center justify-center rounded-lg border bg-background px-6 font-semibold hover:bg-accent';
---

<section id="contacto" aria-labelledby="contacto-titulo" class="bg-muted">
  <div class="mx-auto max-w-xl space-y-8 px-4 py-16 text-center">
    <div class="space-y-2">
      <h2 id="contacto-titulo" class="text-2xl font-bold md:text-3xl">Sumate</h2>
      <p class="text-muted-foreground">Escribinos y te contamos cómo participar de la Comisión.</p>
    </div>

    <ul class="flex flex-col gap-3">
      <li>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-foreground hover:opacity-90"
        >
          Escribinos por WhatsApp<span class="sr-only"> (abre en otra pestaña)</span>
        </a>
      </li>
      <li>
        <a href={mailtoUrl()} class={enlaceSecundario}>
          Mail:&nbsp;<span class="font-normal break-all">{sitio.contacto.mail}</span>
        </a>
      </li>
      <li>
        <a href={instagramUrl()} target="_blank" rel="noopener noreferrer" class={enlaceSecundario}>
          Instagram:&nbsp;<span class="font-normal">@{sitio.contacto.instagram}</span>
          <span class="sr-only"> (abre en otra pestaña)</span>
        </a>
      </li>
    </ul>
  </div>
</section>
