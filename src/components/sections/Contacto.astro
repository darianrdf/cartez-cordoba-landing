---
import Mail from '@lucide/astro/icons/mail';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Instagram from '@/components/iconos/Instagram.astro';
import { getSitio } from '@/lib/data';
import { instagramUrl, mailtoUrl, whatsappUrl } from '@/lib/sitio';

const { contacto, sumate } = await getSitio();

// Botones dorados con texto navy (5,9:1). Cada medio es opcional: solo se renderizan los que tienen dato.
const claseBoton =
  'flex min-h-14 w-full items-center justify-center gap-3 rounded-full bg-gold px-6 font-semibold text-navy shadow-lg ' +
  'transition-colors duration-200 hover:bg-white motion-reduce:transition-none';
const hayContacto = Boolean(contacto.whatsapp || contacto.mail || contacto.instagram);
---

<section id="contacto" aria-labelledby="contacto-titulo" class="bg-navy text-white">
  <div class="mx-auto max-w-3xl space-y-10 px-4 py-20 text-center md:py-28">
    <div class="space-y-5">
      <h2 id="contacto-titulo" class="titulo-seccion centrado text-white">Sumate</h2>
      {
        sumate.map((parrafo, i) => (
          <p class:list={['mx-auto max-w-2xl text-base leading-relaxed text-pretty md:text-lg', i === 0 ? 'text-white' : 'text-on-dark-muted']}>
            {parrafo}
          </p>
        ))
      }
    </div>

    {
      hayContacto ? (
        <ul class="mx-auto flex max-w-md flex-col gap-4">
          {contacto.whatsapp && (
            <li class="aparecer">
              <a
                href={whatsappUrl(contacto.whatsapp, contacto.whatsappMensaje)}
                target="_blank"
                rel="noopener noreferrer"
                class={claseBoton}
              >
                <MessageCircle size={22} aria-hidden="true" />
                Escribinos por WhatsApp
                <span class="sr-only">(abre en otra pestaña)</span>
              </a>
            </li>
          )}
          {contacto.instagram && (
            <li class="aparecer">
              <a href={instagramUrl(contacto.instagram)} target="_blank" rel="noopener noreferrer" class={claseBoton}>
                <Instagram size={22} />
                <span>
                  <span class="sr-only">Instagram: </span>@{contacto.instagram}
                </span>
                <span class="sr-only">(abre en otra pestaña)</span>
              </a>
            </li>
          )}
          {contacto.mail && (
            <li class="aparecer">
              <a href={mailtoUrl(contacto.mail)} class={claseBoton}>
                <Mail size={22} aria-hidden="true" class="shrink-0" />
                <span class="text-sm sm:text-base">
                  <span class="sr-only">Mail: </span>
                  {/* Permite cortar antes de la @ en pantallas angostas */}
                  {contacto.mail.split('@')[0]}<wbr />@{contacto.mail.split('@').slice(1).join('@')}
                </span>
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p class="text-on-dark-muted">Muy pronto vas a encontrar acá cómo contactarnos.</p>
      )
    }
  </div>
</section>
