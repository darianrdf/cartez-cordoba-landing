---
import { Image } from 'astro:assets';
import { getEventos } from '@/lib/data';
import { ETIQUETAS_CATEGORIA } from '@/lib/eventos';
import { estadoEvento, formatearRango, inicioEvento, isoConOffset, vencimientoEvento } from '@/lib/fechas';
import { instagramUrl, sitio } from '@/lib/sitio';
import { cn } from '@/lib/utils';

const ahora = new Date();
const eventos = await getEventos(ahora);
---

<section id="eventos" aria-labelledby="eventos-titulo" class="border-b bg-muted">
  <div class="mx-auto max-w-5xl space-y-8 px-4 py-16">
    <div class="space-y-2">
      <h2 id="eventos-titulo" class="text-2xl font-bold md:text-3xl">Próximos eventos</h2>
      <p class="text-muted-foreground">Agenda del sector agropecuario: actividades propias y eventos a los que vamos.</p>
    </div>

    <!-- Siempre se renderiza: el script lo muestra si todos los eventos vencieron después del build -->
    <div data-eventos-vacio hidden={eventos.length > 0} class="rounded-lg border border-dashed bg-background p-8 text-center">
      <p class="font-medium">Por ahora no hay eventos programados.</p>
      <p class="mt-1 text-muted-foreground">
        Seguinos en{' '}
        <a href={instagramUrl()} class="underline underline-offset-4" target="_blank" rel="noopener noreferrer">
          Instagram (@{sitio.contacto.instagram})
        </a>{' '}
        para enterarte de lo próximo.
      </p>
    </div>

    {
      eventos.length > 0 && (
        <ul data-eventos-lista class="grid gap-4 md:grid-cols-2">
          {eventos.map((evento) => {
            const propio = evento.organizador === 'propio';
            const enCurso = estadoEvento(evento, ahora) === 'en-curso';
            return (
              <li
                data-evento
                data-inicio={isoConOffset(inicioEvento(evento.fecha))}
                data-vence={isoConOffset(vencimientoEvento(evento.fechaFin))}
              >
                <article
                  class={cn(
                    'flex h-full flex-col overflow-hidden rounded-lg bg-card text-card-foreground',
                    propio ? 'border-2 border-primary' : 'border border-dashed',
                  )}
                >
                  {typeof evento.flyer === 'string' ? (
                    <img
                      src={evento.flyer}
                      alt={`Flyer de ${evento.titulo}`}
                      width="800"
                      height="450"
                      loading="lazy"
                      decoding="async"
                      class="aspect-video w-full object-cover"
                    />
                  ) : (
                    evento.flyer && (
                      <Image
                        src={evento.flyer}
                        alt={`Flyer de ${evento.titulo}`}
                        widths={[400, 800]}
                        sizes="(min-width: 768px) 480px, 100vw"
                        class="aspect-video w-full object-cover"
                      />
                    )
                  )}
                  <div class="flex flex-1 flex-col gap-3 p-5">
                    <div class="flex flex-wrap gap-2 text-xs font-semibold">
                      <span data-en-curso hidden={!enCurso} class="rounded-full bg-foreground px-2.5 py-1 text-background">
                        En curso
                      </span>
                      <span
                        class={cn(
                          'rounded-full px-2.5 py-1',
                          propio ? 'bg-primary text-primary-foreground' : 'border border-dashed',
                        )}
                      >
                        {propio ? 'Organiza la Comisión' : 'Evento externo'}
                      </span>
                      <span class="rounded-full bg-secondary px-2.5 py-1 text-secondary-foreground">
                        {ETIQUETAS_CATEGORIA[evento.categoria]}
                      </span>
                    </div>
                    <h3 class="text-lg font-semibold">{evento.titulo}</h3>
                    <dl class="space-y-1 text-sm text-muted-foreground">
                      <dt class="sr-only">Fecha</dt>
                      <dd>
                        <time datetime={evento.fecha}>{formatearRango(evento.fecha, evento.fechaFin)}</time>
                      </dd>
                      <dt class="sr-only">Lugar</dt>
                      <dd>{evento.lugar}</dd>
                    </dl>
                    {evento.descripcion && <p class="text-sm">{evento.descripcion}</p>}
                    {evento.link && (
                      <a
                        href={evento.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-auto self-start text-sm font-semibold underline underline-offset-4"
                      >
                        Más información<span class="sr-only"> sobre {evento.titulo} (abre en otra pestaña)</span>
                      </a>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<script>
  // Segundo filtro: el sitio es estático, así que al cargar se ocultan los eventos que
  // vencieron después del último build y se actualiza la etiqueta "En curso".
  import { estadoPorInstantes } from '@/lib/fechas';

  const ahora = Date.now();
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-evento]');
  let visibles = 0;

  for (const tarjeta of tarjetas) {
    const estado = estadoPorInstantes(Date.parse(tarjeta.dataset.inicio!), Date.parse(tarjeta.dataset.vence!), ahora);
    tarjeta.hidden = estado === 'vencido';
    tarjeta.querySelector<HTMLElement>('[data-en-curso]')?.toggleAttribute('hidden', estado !== 'en-curso');
    if (!tarjeta.hidden) visibles++;
  }

  if (tarjetas.length > 0 && visibles === 0) {
    document.querySelector<HTMLElement>('[data-eventos-lista]')?.setAttribute('hidden', '');
    document.querySelector<HTMLElement>('[data-eventos-vacio]')?.removeAttribute('hidden');
  }
</script>
