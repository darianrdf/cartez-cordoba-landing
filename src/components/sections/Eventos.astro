---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import TarjetaEvento from '@/components/eventos/TarjetaEvento.astro';
import Instagram from '@/components/iconos/Instagram.astro';
import { getEventos, getEventosAnteriores, getSitio } from '@/lib/data';
import { instagramUrl } from '@/lib/sitio';

const ahora = new Date();
const eventos = await getEventos(ahora);
const hayAnteriores = (await getEventosAnteriores(ahora)).length > 0;
const sitio = await getSitio();
const { instagram } = sitio.contacto;
---

<section id="eventos" aria-labelledby="eventos-titulo" class="bg-tint-green">
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-20 md:py-28">
    <div class="space-y-3">
      <h2 id="eventos-titulo" class="titulo-seccion">Próximos eventos</h2>
      <p class="max-w-2xl text-lg text-navy-muted">
        Agenda del sector agropecuario: actividades propias y eventos a los que vamos.
      </p>
    </div>

    <!-- Siempre se renderiza: el script lo muestra si todos los eventos vencieron después del build -->
    <div
      data-eventos-vacio
      hidden={eventos.length > 0}
      class="mx-auto flex max-w-2xl flex-col items-center gap-6 rounded-xl border-2 border-dashed border-green bg-white px-6 py-10 text-center md:px-10"
    >
      <span class="flex size-14 items-center justify-center rounded-full bg-tint-green text-green">
        <CalendarDays size={28} aria-hidden="true" />
      </span>
      <p class="font-display text-xl leading-snug font-semibold text-pretty text-navy md:text-2xl">{sitio.eventosVacio}</p>
      {
        instagram && (
          <a
            href={instagramUrl(instagram)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-green-strong px-6 font-semibold text-white shadow-md transition-colors hover:bg-navy motion-reduce:transition-none"
          >
            <Instagram size={20} />
            Seguinos en Instagram
            <span class="sr-only">(@{instagram}, abre en otra pestaña)</span>
          </a>
        )
      }
    </div>

    {
      eventos.length > 0 && (
        <ul data-eventos-lista class="grilla-eventos grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {eventos.map((evento) => (
            <TarjetaEvento evento={evento} ahora={ahora} />
          ))}
        </ul>
      )
    }

    {
      // Si un evento termina después del build, el script muestra el link (la página ya lo incluye).
      (hayAnteriores || eventos.length > 0) && (
        <p data-ver-anteriores hidden={!hayAnteriores}>
          <a
            href="/eventos/anteriores/"
            class="inline-flex items-center gap-1 rounded-md font-semibold text-green-strong underline-offset-4 hover:underline"
          >
            Ver eventos anteriores
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </p>
      )
    }
  </div>
</section>

<script>
  // Segundo filtro: el sitio es estático, así que al cargar se ocultan los eventos que
  // vencieron después del último build y se actualiza la etiqueta "Hoy"/"En curso".
  import { estadoPorInstantes } from '@/lib/fechas';

  const ahora = Date.now();
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-eventos-lista] [data-evento]');
  let visibles = 0;

  for (const tarjeta of tarjetas) {
    const estado = estadoPorInstantes(Date.parse(tarjeta.dataset.inicio!), Date.parse(tarjeta.dataset.vence!), ahora);
    tarjeta.hidden = estado === 'vencido';
    tarjeta.querySelector<HTMLElement>('[data-en-curso]')?.toggleAttribute('hidden', estado !== 'en-curso');
    if (!tarjeta.hidden) visibles++;
  }
  if (visibles < tarjetas.length) document.querySelector('[data-ver-anteriores]')?.removeAttribute('hidden');

  if (tarjetas.length > 0 && visibles === 0) {
    document.querySelector<HTMLElement>('[data-eventos-lista]')?.setAttribute('hidden', '');
    document.querySelector<HTMLElement>('[data-eventos-vacio]')?.removeAttribute('hidden');
  }
</script>
