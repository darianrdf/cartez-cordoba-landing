---
import { sitio } from '@/lib/sitio';
---

<section id="inicio" aria-labelledby="hero-titulo" class="border-b">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 py-16 text-center md:py-24">
    <!-- Placeholder del logo redondo -->
    <div
      role="img"
      aria-label={`Logo de ${sitio.organizacion}`}
      class="flex size-32 items-center justify-center rounded-full bg-placeholder text-xs font-medium text-placeholder-foreground md:size-40"
    >
      Logo redondo
    </div>

    <div class="space-y-3">
      <h1 id="hero-titulo" class="text-3xl font-bold tracking-tight md:text-5xl">
        {sitio.nombre}
        <span class="block text-lg font-medium text-muted-foreground md:text-2xl">{sitio.organizacion}</span>
      </h1>
      <p class="mx-auto max-w-xl text-lg text-muted-foreground">{sitio.heroFrase}</p>
    </div>

    <a
      href="#contacto"
      class="inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-8 text-base font-semibold text-primary-foreground hover:opacity-90"
    >
      Sumate
    </a>
  </div>
</section>
