---
import { Image } from 'astro:assets';
import logoRedondo from '@/assets/logos/logo-redondo.png';
import { sitio } from '@/lib/sitio';
---

<!-- El fondo debe ser claro: el logo es transparente y está pensado para fondos claros -->
<section id="inicio" aria-labelledby="hero-titulo" class="border-b bg-background">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 py-12 text-center md:py-20">
    <Image
      src={logoRedondo}
      alt={sitio.logoAlt}
      width={240}
      densities={[1, 2]}
      quality={75}
      loading="eager"
      fetchpriority="high"
      class="h-auto w-48 md:w-60"
    />

    <div class="space-y-3">
      <h1 id="hero-titulo" class="text-3xl font-bold tracking-tight md:text-5xl">
        {sitio.nombre}
        <span class="block text-lg font-medium text-muted-foreground md:text-2xl">{sitio.organizacion}</span>
      </h1>
      <p class="mx-auto max-w-xl text-lg text-muted-foreground">{sitio.heroFrase}</p>
    </div>

    <a
      href="#contacto"
      class="inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-8 text-base font-semibold text-primary-foreground hover:opacity-90"
    >
      Sumate
    </a>
  </div>
</section>
