---
import { getSitio } from '@/lib/data';

const sitio = await getSitio();

const bloques = [sitio.conocenos.ateneo, sitio.conocenos.comision];
---

<section id="conocenos" aria-labelledby="conocenos-titulo" class="border-b">
  <div class="mx-auto max-w-5xl space-y-10 px-4 py-16">
    <h2 id="conocenos-titulo" class="text-2xl font-bold md:text-3xl">Conocenos</h2>

    <div class="grid gap-8 md:grid-cols-2">
      {
        bloques.map(({ titulo, texto }) => (
          <article class="space-y-2">
            <h3 class="text-xl font-semibold">{titulo}</h3>
            <p class="text-muted-foreground">{texto}</p>
          </article>
        ))
      }
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-semibold">Nuestros objetivos</h3>
      <ol class="grid gap-3 sm:grid-cols-2">
        {
          sitio.objetivos.map((objetivo, i) => (
            <li class="flex gap-3 rounded-lg border bg-card p-4 text-card-foreground">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-semibold text-secondary-foreground"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <span>{objetivo}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
