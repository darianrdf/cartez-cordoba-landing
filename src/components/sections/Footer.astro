---
import { Image } from 'astro:assets';
import Mail from '@lucide/astro/icons/mail';
import logoDisco from '@/assets/logos/logo-disco.png';
import Instagram from '@/components/iconos/Instagram.astro';
import { secciones } from '@/data/navegacion';
import { getSitio } from '@/lib/data';
import { instagramUrl, mailtoUrl, nombreCompleto } from '@/lib/sitio';

const sitio = await getSitio();
const { instagram, mail } = sitio.contacto;
const anio = new Date().getFullYear();

const claseTituloBloque = 'font-sans text-xs font-semibold tracking-widest text-gold uppercase';
const claseLink = 'text-white transition-colors hover:text-gold motion-reduce:transition-none';
---

<footer class="bg-navy-deep text-white">
  <div class="mx-auto max-w-6xl px-4 pt-14 pb-8">
    <div class="grid gap-10 text-center md:grid-cols-3 md:text-left">
      <!-- Logo, descripción e Instagram. El logo va en disco blanco porque está pensado para fondo claro. -->
      <div class="flex flex-col items-center gap-4 md:items-start">
        <Image src={logoDisco} alt={nombreCompleto(sitio)} width={72} densities={[1, 2]} class="size-18 rounded-full" />
        <p class="max-w-xs text-sm leading-relaxed text-on-dark-muted">{sitio.descripcionMeta}</p>
        {
          instagram && (
            <a
              href={instagramUrl(instagram)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-11 items-center justify-center rounded-full ring-1 ring-white/30 transition-colors hover:bg-gold hover:text-navy motion-reduce:transition-none"
            >
              <Instagram size={20} />
              <span class="sr-only">Instagram de {sitio.nombre} (abre en otra pestaña)</span>
            </a>
          )
        }
      </div>

      <nav aria-label="Secciones" class="space-y-4">
        <h2 class={claseTituloBloque}>Secciones</h2>
        <ul class="space-y-2">
          {
            secciones.map(({ id, etiqueta }) => (
              <li>
                <a href={`#${id}`} class={claseLink}>
                  {etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        mail && (
          <div class="space-y-4">
            <h2 class={claseTituloBloque}>Contacto</h2>
            <a href={mailtoUrl(mail)} class:list={[claseLink, 'inline-flex items-center gap-2 text-sm break-all']}>
              <Mail size={18} aria-hidden="true" class="shrink-0" />
              {mail}
            </a>
          </div>
        )
      }
    </div>

    <div class="mt-12 border-t border-white/15 pt-6 text-center text-sm text-on-dark-muted">
      <p>© {anio} {nombreCompleto(sitio)}</p>
    </div>
  </div>
</footer>
