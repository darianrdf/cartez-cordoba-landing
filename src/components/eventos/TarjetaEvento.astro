---
/**
 * Tarjeta de un evento (home y Eventos anteriores). Lleva a la página del evento.
 * `data-inicio` / `data-vence` permiten que el script de la página la actualice si el evento
 * empezó o terminó después del último build.
 */
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CalendarDays from '@lucide/astro/icons/calendar-days';
import MapPin from '@lucide/astro/icons/map-pin';
import { horario, imagenDeEvento, rutaEvento } from '@/lib/eventos';
import { estadoEvento, etiquetaEnCurso, formatearRango, inicioEvento, isoConOffset, vencimientoEvento } from '@/lib/fechas';
import { FOTOS_POR_CATEGORIA } from '@/lib/fotos';
import { propsImagen } from '@/lib/imagenes';
import type { Evento } from '@/lib/tipos';
import { cn } from '@/lib/utils';

interface Props {
  evento: Evento;
  ahora: Date;
  /** Eventos anteriores: muestra el año y "Finalizado". */
  anterior?: boolean;
  /** Oculta en el build (el script la muestra si corresponde). */
  oculta?: boolean;
}

const { evento, ahora, anterior = false, oculta = false } = Astro.props;
const estado = estadoEvento(evento, ahora);
const hora = horario(evento);
const anio = evento.fechaFin.slice(0, 4);
const fecha = formatearRango(evento.fecha, evento.fechaFin);
---

<li
  data-evento
  data-inicio={isoConOffset(inicioEvento(evento.fecha))}
  data-vence={isoConOffset(vencimientoEvento(evento.fechaFin))}
  hidden={oculta}
  class="tarjeta-evento"
>
  <a
    href={rutaEvento(evento)}
    class={cn(
      'aparecer relative isolate flex h-80 flex-col justify-end overflow-hidden rounded-xl bg-navy text-white shadow-lg',
      evento.organizaComision && 'ring-2 ring-gold',
    )}
  >
    <Image
      {...propsImagen(imagenDeEvento(evento, FOTOS_POR_CATEGORIA))}
      alt=""
      widths={[400, 640, 800, 1200]}
      sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw"
      quality={60}
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/45 to-transparent"></div>

    <div class="absolute inset-x-4 top-4 flex items-start justify-between gap-2 text-xs font-semibold">
      <span
        class={cn(
          'rounded-full px-3 py-1',
          evento.organizaComision ? 'bg-gold text-navy' : 'bg-navy/85 text-white ring-1 ring-white/60',
        )}
      >
        {evento.organizaComision ? 'Organiza la Comisión' : 'Evento externo'}
      </span>
      {
        anterior ? (
          <span class="rounded-full bg-navy px-3 py-1 text-white shadow ring-1 ring-white/60">Finalizado</span>
        ) : (
          <span data-en-curso hidden={estado !== 'en-curso'} class="rounded-full bg-green-strong px-3 py-1 text-white shadow">
            {etiquetaEnCurso(evento.fecha, evento.fechaFin)}
          </span>
        )
      }
    </div>

    <div class="space-y-2 p-5">
      <p class="text-xs font-semibold tracking-widest text-gold uppercase">{evento.tipo}</p>
      <h3 class="line-clamp-2 font-display text-xl leading-snug font-semibold">{evento.titulo}</h3>
      <dl class="space-y-1 text-sm text-white">
        <div class="flex items-center gap-2">
          <dt>
            <CalendarDays size={16} aria-hidden="true" />
            <span class="sr-only">Fecha</span>
          </dt>
          <dd>
            <time datetime={evento.fecha}>{anterior && !/\d{4}$/.test(fecha) ? `${fecha} ${anio}` : fecha}</time>
            {hora && <span> · {hora}</span>}
          </dd>
        </div>
        <div class="flex items-center gap-2">
          <dt>
            <MapPin size={16} aria-hidden="true" />
            <span class="sr-only">Lugar</span>
          </dt>
          <dd class="truncate">{evento.lugar}</dd>
        </div>
      </dl>
      {evento.descripcion && <p class="line-clamp-2 text-sm text-white/90">{evento.descripcion}</p>}
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        {
          evento.comisionParticipa && !evento.organizaComision && (
            <span class="rounded-full bg-tint-green px-3 py-1 text-xs font-semibold text-green-strong">
              {anterior ? 'La Comisión participó' : 'La Comisión participa'}
            </span>
          )
        }
        <span class="ml-auto inline-flex items-center gap-1 text-sm font-semibold text-gold">
          Ver más
          <ArrowRight size={16} aria-hidden="true" />
        </span>
      </div>
    </div>
  </a>
</li>
